{
  "dart.analysisExcludedFolders": [
    "**/build",
    "**/.dart_tool",
    "**/generated_plugin_registrant.dart"
  ],
  "dart.openFileLinks": "prompt",
  "files.exclude": {
    "**/.dart_tool": true,
    "**/build": true,
    "**/.packages": true,
    "**/.pub-cache": true
  },
  "search.exclude": {
    "**/.dart_tool": true,
    "**/build": true,
    "**/*.g.dart": true,
    "**/*.freezed.dart": true,
    "**/*.mocks.dart": true
  },
  "dart.analysisServerBusyThreshold": 5,
  "dart.maxAnalysisSdkMemory": 4096
}
